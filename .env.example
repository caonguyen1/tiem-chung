# Copy to .env and adjust. Local values match docker-compose.yml.
POSTGRES_DB=tiem_chung
POSTGRES_USER=tiem_chung
POSTGRES_PASSWORD=tiem_chung_dev
POSTGRES_PORT=5436
DATABASE_URL=postgres://tiem_chung:tiem_chung_dev@localhost:5436/tiem_chung

# First admin account created by `pnpm db:seed` (change the password after the first login).
ADMIN_EMAIL=admin@tamtri.local
ADMIN_PASSWORD=change-me-please

# Public address of the site (canonical links, sitemap). Set to the real domain on the server.
SITE_URL=http://localhost:3210

# Folder for images uploaded in the admin; keep it on a persistent disk.
UPLOAD_DIR=data/uploads
